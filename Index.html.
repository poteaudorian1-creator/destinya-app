  <title>Destinya — Rencontres et amitiés</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; padding: 20px; display: grid; place-items: center;
      font-family: Arial, sans-serif; background: linear-gradient(145deg,#fff0ed,#ffd6df,#ffe8d6); color: #593b49; }
    .container { width: 100%; max-width: 430px; padding: 30px 24px; background: white;
      border-radius: 28px; box-shadow: 0 12px 35px #b76b7b30; text-align: center; }
    h1 { color: #d65c82; font-size: 40px; } h2 { color: #bd5275; } .heart { font-size: 55px; }
    label { display: block; text-align: left; margin: 12px 0 4px; font-size: 14px; }
    input { width: 100%; padding: 15px; border: 1px solid #f2c2d0; border-radius: 14px; font-size: 16px; }
    button { width: 100%; padding: 15px; margin: 8px 0; border: 0; border-radius: 30px;
      font-size: 16px; font-weight: bold; cursor: pointer; }
    .primary { background: #d65c82; color: white; } .secondary { background: #ffe1e8; color: #a94368; }
    .hidden { display: none; } #message { overflow-wrap: anywhere; color: #a94368; min-height: 1.4em; }
    small { display: block; margin: 10px 0; line-height: 1.5; }
    a { color: #a94368; }
  </style>
</head>
<body>
  <main class="container">
    <section id="home">
      <div class="heart" aria-hidden="true">💕</div>
      <h1>Destinya</h1>
      <p>De belles rencontres et de nouvelles amitiés.</p>
      <button class="primary" type="button" data-page="register">Créer un compte</button>
      <button class="secondary" type="button" data-page="login">Se connecter</button>
    </section>

    <section id="register" class="hidden">
      <h2>Créer mon compte</h2>
      <form id="registerForm">
        <label for="name">Prénom</label>
        <input id="name" type="text" maxlength="40" autocomplete="given-name" required>
        <label for="birthdate">Date de naissance</label>
        <input id="birthdate" type="date" required>
        <label for="email">Adresse e-mail</label>
        <input id="email" type="email" autocomplete="email" required>
        <label for="password">Mot de passe (8 caractères minimum)</label>
        <input id="password" type="password" minlength="8" autocomplete="new-password" required>
        <small>Réservé aux personnes de 18 ans et plus. La date déclarée n'est pas une vérification d'identité.</small>
        <button class="primary" type="submit">Créer mon compte</button>
      </form>
      <button class="secondary" type="button" data-page="home">Retour</button>
    </section>

    <section id="login" class="hidden">
      <h2>Connexion</h2>
      <form id="loginForm">
        <label for="loginEmail">Adresse e-mail</label>
        <input id="loginEmail" type="email" autocomplete="email" required>
        <label for="loginPassword">Mot de passe</label>
        <input id="loginPassword" type="password" autocomplete="current-password" required>
        <button class="primary" type="submit">Se connecter</button>
      </form>
      <button class="secondary" type="button" data-page="home">Retour</button>
    </section>

    <section id="account" class="hidden">
      <div class="heart" aria-hidden="true">💗</div>
      <h2>Bienvenue sur Destinya !</h2>
      <p id="userEmail"></p>
      <p id="verificationInfo"></p>
      <button class="primary hidden" id="resendVerification" type="button">Renvoyer le mail de vérification</button>
      <button class="secondary" id="logout" type="button">Se déconnecter</button>
    </section>
    <p id="message" role="status" aria-live="polite"></p>
  </main>

